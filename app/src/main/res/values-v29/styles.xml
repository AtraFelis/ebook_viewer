<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Force Dark must not invert PDF pixels or override an explicit Light choice. -->
    <style name="ReaderLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:alertDialogTheme">@style/ReaderAlertLight</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="ReaderDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:alertDialogTheme">@style/ReaderAlertDark</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="ReaderAlertLight" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="ReaderAlertDark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
