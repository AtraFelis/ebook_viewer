<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Force Dark must not invert PDF pixels or override an explicit Light choice. -->
    <style name="ReaderLight" parent="ReaderLightBase">
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="ReaderDark" parent="ReaderDarkBase">
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="ReaderAlertLight" parent="ReaderAlertLightBase">
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="ReaderAlertDark" parent="ReaderAlertDarkBase">
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
